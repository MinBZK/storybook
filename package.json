{
  "name": "@minbzk/storybook",
  "version": "0.8.11",
  "description": "Design System voor RegelRecht - Nederlandse Overheid",
  "type": "module",
  "main": "dist/components/rr-components.js",
  "module": "dist/components/rr-components.js",
  "exports": {
    ".": "./dist/components/rr-components.js",
    "./css": "./dist/css/tokens.css"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MinBZK/storybook.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "npm run build:tokens && npm run validate:tokens && npm run build:components",
    "build:tokens": "mkdir -p dist/css && cp src/assets/styles/settings.css dist/css/tokens.css",
    "validate:tokens": "node scripts/validate-css-variables.js",
    "build:components": "npm run clean:components && vite build",
    "clean": "rm -rf dist",
    "clean:components": "rm -rf dist/components",
    "storybook": "storybook dev -p 6006",
    "sb:start": "node scripts/storybook-manager.js start",
    "sb:stop": "node scripts/storybook-manager.js stop",
    "sb:status": "node scripts/storybook-manager.js status",
    "sb:stop-all": "node scripts/storybook-manager.js stop-all",
    "build-storybook": "storybook build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:a11y": "eslint src/ --rule 'lit-a11y/*: error'",
    "format": "prettier --write \"src/**/*.{js,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,css,md}\"",
    "prepare": "pre-commit install || true",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-themes": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/web-components-vite": "^10.1.10",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.17.0",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "globals": "^15.14.0",
    "playwright": "^1.57.0",
    "prettier": "^3.4.2",
    "semantic-release": "^25.0.2",
    "storybook": "^10.1.10",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "design-system",
    "web-components",
    "rijksoverheid",
    "regelrecht"
  ],
  "license": "EUPL-1.2",
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@rijkshuisstijl-community/font": "^1.1.2",
    "lit": "^3.3.1"
  }
}
