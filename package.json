{
  "name": "@minbzk/storybook",
  "version": "0.8.20",
  "description": "Design System voor Nederlandse Digitale Dienst",
  "type": "module",
  "main": "dist/components/ndd-components.js",
  "module": "dist/components/ndd-components.js",
  "exports": {
    ".": "./dist/components/ndd-components.js",
    "./styles": "./dist/css/global.css",
    "./styles/tokens": "./dist/css/settings.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MinBZK/storybook.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "npm run build:styles && npm run validate:styles && npm run build:components",
    "build:styles": "mkdir -p dist/css dist/fonts && cp src/assets/styles/settings.css dist/css/settings.css && cp src/components/content/rich-text/ndd-rich-text.css dist/css/ndd-rich-text.css && printf '@import \"./settings.css\";\\n@import \"./ndd-rich-text.css\";\\n' > dist/css/global.css && cp src/assets/fonts/*.ttf src/assets/fonts/*.woff2 dist/fonts/",
    "validate:styles": "node scripts/validate-css-variables.js",
    "build:components": "npm run clean:components && vite build",
    "clean": "rm -rf dist",
    "clean:components": "rm -rf dist/components",
    "storybook": "storybook dev -p 6006",
    "sb:start": "node scripts/storybook-manager.js start",
    "sb:stop": "node scripts/storybook-manager.js stop",
    "sb:status": "node scripts/storybook-manager.js status",
    "sb:stop-all": "node scripts/storybook-manager.js stop-all",
    "build-storybook": "storybook build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:a11y": "eslint src/ --rule 'lit-a11y/*: error'",
    "prepare": "pre-commit install || true",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-a11y": "^10.3.4",
    "@storybook/addon-docs": "^10.3.4",
    "@storybook/addon-themes": "^10.3.4",
    "@storybook/addon-vitest": "^10.3.4",
    "@storybook/web-components-vite": "^10.3.4",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.17.0",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-storybook": "^10.3.4",
    "globals": "^15.14.0",
    "playwright": "^1.57.0",
    "semantic-release": "^25.0.2",
    "storybook": "^10.3.4",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "design-system",
    "web-components",
    "rijksoverheid",
    "ndd"
  ],
  "license": "EUPL-1.2",
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@rijkshuisstijl-community/font": "^1.1.2",
    "lit": "^3.3.1"
  }
}
